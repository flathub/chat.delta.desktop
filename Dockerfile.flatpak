# Environment for running the real flatpak-builder build locally, so the whole
# manifest can be verified end-to-end without pushing to CI. Separate from the
# node-only Dockerfile (generate.sh) because this pulls in flatpak + a few GB of
# runtimes. Driven by build_in_docker.sh.
# Debian trixie (not bookworm): its flatpak-builder is new enough to invoke
# `appstreamcli compose` instead of the removed `appstream-compose`, which the
# freedesktop 25.08 SDK no longer ships (bookworm's flatpak-builder fails the
# metainfo finalization with "execvp appstream-compose: No such file").
FROM debian:trixie

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        flatpak \
        flatpak-builder \
        ostree \
        git \
        python3 \
        ca-certificates \
        curl \
        elfutils \
        unzip \
        xz-utils \
        zstd \
        bzip2 \
        librsvg2-common \
    && rm -rf /var/lib/apt/lists/*

# /work is a named volume that keeps the flatpak user installation (runtimes),
# the flatpak-builder download/cache state and the build dir between runs. The
# container runs as the host user, so these must be writable for everyone.
RUN mkdir -p /work/home && chmod 777 /work /work/home

WORKDIR /work/flatpak-desktop
